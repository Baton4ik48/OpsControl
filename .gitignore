# ================================
# Python cache / compiled files
# ================================

# Папки кэша Python
__pycache__/

# Скомпилированные файлы Python
*.pyc
*.pyo
*.pyd


# ================================
# Environment files (секреты)
# ================================

# Игнорируем ВСЕ .env файлы в любых папках
**/.env

# Игнорируем любые env-вариации (.env.local, .env.prod и т.д.)
**/.env.*

# НО разрешаем шаблоны
!**/.env.example


# ================================
# Logs
# ================================

# Игнорируем все логи фронта
frontend/logs/**

# Игнорируем все логи бэкенда
backend/logs/**

# Игнор файлов
readme.txt
main.spec

frontend/build
frontend/dist
frontend/venv

# ================================
# Примечание
# ================================
# .env файлы содержат секреты (пароли, токены, креды)
# Они НЕ должны попадать в репозиторий.
# Для структуры используем .env.example
#
# Логи не хранятся в git.
# Если нужно сохранить папку logs — используем .gitkeep