# =========================================================
# 🌍 ENVIRONMENT
# =========================================================
# dev | prod
APP_ENV=prod

# =========================================================
# 🐘 DATABASE (Postgres + Vault connection)
# =========================================================

# Example (inside docker): http://vault:5432
# Example (external): http://your-server-ip:5432
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ppm_database
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
# Вместо значения напрямую можно задать путь к файлу с секретом:
# POSTGRES_PASSWORD_FILE=/run/secrets/db_password
# (если задана *_FILE — она в приоритете над POSTGRES_PASSWORD)

POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_QUERY_TIMEOUT=3

# =========================================================
# 🔐 VAULT (Backend access)
# =========================================================

# Example (inside docker): http://vault:8200
# Example (external): http://your-server-ip:8200
VAULT_ADDR=http://vault:8200

VAULT_HTTP_TIMEOUT=5

# Auth method: approle | userpass | token
VAULT_AUTH_METHOD=approle

# Получаются после запуска vault-init.sh
VAULT_ROLE_ID=replace_after_init
VAULT_SECRET_ID=replace_after_init
# Аналогично поддерживаются VAULT_ROLE_ID_FILE / VAULT_SECRET_ID_FILE

# Vault DB role (must match vault-init.sh)
VAULT_DATABASE_ROLE_NAME=postgres-dynamic

# =========================================================
# 🔐 VAULT INIT (используется только vault-init.sh)
# =========================================================

# Пароль для admin пользователя Vault (userpass auth)
VAULT_ADMIN_PASSWORD=change_me

# =========================================================
# ⚙️ DATABASE MODE (Backend logic)
# =========================================================

# static → всегда использовать .env
# vault  → только Vault
# auto   → сначала Vault, fallback на static
DB_CREDS_MODE=vault

