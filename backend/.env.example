# =========================================================
# ENVIRONMENT
# =========================================================
APP_ENV=dev

# =========================================================
# VAULT CONFIG
# =========================================================

# Vault base address (http:// or https://)
VAULT_ADDR=
# HTTP timeout in seconds
VAULT_HTTP_TIMEOUT=5
# Auth method: approle | userpass | token
VAULT_AUTH_METHOD=approle

# AppRole credentials
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# Vault database role name
VAULT_DATABASE_ROLE_NAME=

# =========================================================
# DATABASE CONFIG
# =========================================================

# static | vault | auto
DB_CREDS_MODE=static

# Connection behaviour
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_QUERY_TIMEOUT=3

# Static fallback config (used if mode=static or auto fallback)
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=