QWidget {
    background-color: #0f1b1e;
    color: #d8d8d8;
    font-family: Segoe UI;
    font-size: 10pt;
}

QLineEdit {
    background-color: #0f1b1e;
    color: #d8d8d8;
    border: 1px solid #2a4a52;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #2fa4a9;
}

QLineEdit:focus {
    border: 1px solid #2fa4a9;
}

QLineEdit:disabled {
    background-color: #111f25;
    color: #546e7a;
    border: 1px solid #1e3a42;
}

QTextEdit {
    background-color: #0f1b1e;
    color: #d8d8d8;
    border: 1px solid #2a4a52;
    border-radius: 4px;
    padding: 4px;
    selection-background-color: #2fa4a9;
}

QTextEdit:focus {
    border: 1px solid #2fa4a9;
}

QSpinBox {
    background-color: #0f1b1e;
    color: #d8d8d8;
    border: 1px solid #2a4a52;
    border-radius: 4px;
    padding: 3px 6px;
}

QSpinBox:focus {
    border: 1px solid #2fa4a9;
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: #1c2b2e;
    border: none;
    width: 16px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #2a4a52;
}

QSpinBox::up-arrow {
    image: url($$ICONS_DIR$$/arrow_up.svg);
    width: 8px;
    height: 5px;
}

QSpinBox::down-arrow {
    image: url($$ICONS_DIR$$/arrow_down.svg);
    width: 8px;
    height: 5px;
}

QComboBox {
    background-color: #0f1b1e;
    color: #d8d8d8;
    border: 1px solid #2a4a52;
    border-radius: 4px;
    padding: 3px 8px;
}

QComboBox:focus {
    border: 1px solid #2fa4a9;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: url($$ICONS_DIR$$/arrow_down.svg);
    width: 8px;
    height: 5px;
}

QComboBox QAbstractItemView {
    background-color: #1c2b2e;
    color: #d8d8d8;
    border: 1px solid #2a4a52;
    selection-background-color: #2fa4a9;
}

QScrollBar:vertical {
    background: #0f1b1e;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #2a4a52;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #2fa4a9;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #0f1b1e;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #2a4a52;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #2fa4a9;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QGroupBox {
    border: 1px solid #2a4a52;
    border-radius: 6px;
    margin-top: 8px;
    padding-top: 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #90a4ae;
}

QTabWidget::pane {
    border: 1px solid #2a4a52;
    border-radius: 4px;
}

QTabBar::tab {
    background: #1c2b2e;
    color: #90a4ae;
    padding: 5px 14px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #0f1b1e;
    color: #d8d8d8;
    border-bottom: 2px solid #2fa4a9;
}

QTabBar::tab:hover:!selected {
    background: #1e3a42;
    color: #d8d8d8;
}

QCheckBox {
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #2a4a52;
    border-radius: 3px;
    background: #0f1b1e;
}

QCheckBox::indicator:checked {
    background: #2fa4a9;
    border-color: #2fa4a9;
    image: url($$ICONS_DIR$$/checkmark.svg);
}

QCheckBox::indicator:hover {
    border-color: #2fa4a9;
}

QDialog {
    background-color: #0f1b1e;
}

QLabel#dialogTitle {
    font-size: 11pt;
    font-weight: bold;
    color: #cfd8dc;
    padding: 10px 16px 2px 16px;
}

QLabel#dialogSubtitle {
    font-size: 9pt;
    color: #546e7a;
    padding: 0 16px 10px 16px;
}
